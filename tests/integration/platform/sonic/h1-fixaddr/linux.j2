#!/bin/bash
#
# h1-fixaddr custom config (issue #20, sonic-evpnmh.yml) -- h1 is the M-side of a LAG
# dual-homed to s1+s2 on a bridge-mode VLAN. netlab's vlan-module address-pool allocation
# doesn't reach the synthesized vlan1000 SVI on a `linux`-device host in this specific
# lag+bridge-mode combo (single-homed h2 on the SAME vlan gets addressed fine, directly on its
# physical port -- the gap is specific to the derived SVI a dual-homed host needs). Netlab-side
# host-addressing quirk, not a SONiC platform limitation -- worked around here so the h1<->h2
# datapath check has a real IP to ping from.
#
# The address is DERIVED from the VLAN's own prefix, never hardcoded (issue #87). The earlier
# version of this file wrote a literal 172.16.0.5/24; netlab's default VLAN pool later moved to
# 172.18.0.0/24, which put h1 on a different subnet from h2 and made the recorded 0% loss
# result impossible to reproduce -- silently, because the address was still applied successfully.
# Host offset 200 is well clear of netlab's own id-based allocation, so it cannot collide with
# an address netlab assigns to a real node.
#
# IPv4 only, deliberately: netlab leaves /proc/sys/net/ipv6/conf/{bond1,vlan1000}/disable_ipv6
# set to 1 on this host, so an IPv6 address on the SVI is refused by the kernel (RTNETLINK
# Permission denied). Adding an ip -6 line here would render, run, fail silently under the
# || true, and leave a claim nothing backs -- the exact failure this file was rewritten to end.
set -e
{% set p4 = vlans.red.prefix.ipv4 | default('') %}
{% if p4 %}
ip addr add {{ p4 | ipaddr(200) }} dev vlan1000 2>/dev/null || true
{% endif %}
exit 0
