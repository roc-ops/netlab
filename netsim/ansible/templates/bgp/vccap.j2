{#
  vCCAP (Aurora Evo, ex-Casa) BGP (RocContLab #64). Casa NSI Ch.3 (== Casa NSI; template mirrors bgp/casa.j2):
    router bgp <as> ; bgp router-id <id> (sub-option, not standalone)
    neighbor <peer> remote-as <as> | description '<t>' | update-source <if> | next-hop-self
    address-family {ipv4|ipv6} [unicast] ... exit-address-family
    network <ip> mask <mask>   (IPv4 dotted-mask, Casa convention); IPv6: network <ip>/<prefix>
  Casa auto-creates the ipv4-unicast + ipv6 AFs when BGP is enabled; we still emit the AF
  blocks explicitly for activation/advertisement. netlab model: node bgp.{as,router_id,
  neighbors[],advertise[],ipv4,ipv6}; neighbor n.{name,as,ipv4,ipv6,type,activate.{ipv4,ipv6}}.
  (redistribute/bgp.import, peer-groups, route-maps = follow-up in #64.)
#}
router bgp {{ bgp.as }}
{% if bgp.router_id is defined %}
  bgp router-id {{ bgp.router_id }}
{% endif %}
{% if casa_bgp.log_neighbor_changes|default(False) %}
  bgp log-neighbor-changes
{% endif %}
{% if casa_bgp.always_compare_med|default(False) %}
  bgp always-compare-med
{% endif %}
{# ---- external/static peers (device-scoped `casa_bgp.ext_neighbors`): real routers, not lab
       nodes, so netlab's topology-derived bgp.neighbors can't carry them ---- #}
{% for n in casa_bgp.ext_neighbors|default([]) %}
{%   set peer = n.ipv4|default(n.ipv6) %}
  neighbor {{ peer }} remote-as {{ n.remote_as }}
{%   if n.description is defined %}
  neighbor {{ peer }} description "{{ n.description }}"
{%   endif %}
{% endfor %}
{# ---- global neighbor config (one peer address per address family) ---- #}
{% for n in bgp.neighbors %}
{%   for af in ['ipv4','ipv6'] if n[af] is defined and n[af] is string %}
  neighbor {{ n[af] }} remote-as {{ n.as }}
{%     if n.name is defined %}
  neighbor {{ n[af] }} description '{{ n.name }}'
{%     endif %}
{%     if n.type|default('') == 'ibgp' and loopback is defined %}
  neighbor {{ n[af] }} update-source {{ loopback.ifname }}
{%     endif %}
{%   endfor %}
{% endfor %}
{# ---- address families ---- #}
{% for af in ['ipv4','ipv6'] if bgp[af] is defined %}
  address-family {{ af }} unicast
{%   for pfx in bgp.advertise|default([]) if af in pfx %}
{%     if af == 'ipv4' %}
  network {{ pfx[af]|ansible.utils.ipaddr('address') }} mask {{ pfx[af]|ansible.utils.ipaddr('netmask') }}
{%     else %}
  network {{ pfx[af] }}
{%     endif %}
{%   endfor %}
{%   for n in bgp.neighbors if n.activate[af]|default(False) and n[af] is string %}
  neighbor {{ n[af] }} activate
{%     if n.type|default('') == 'ibgp' %}
  neighbor {{ n[af] }} next-hop-self
{%     endif %}
{%   endfor %}
  exit-address-family
{% endfor %}
{# ---- IPv4 unicast AF for the device-scoped external peers: `network <p> mask <m>` +
       per-neighbor activate / advertisement-interval / soft-reconfiguration / prefix-list ---- #}
{% if casa_bgp.networks is defined or casa_bgp.ext_neighbors is defined %}
!
  address-family ipv4 unicast
{% for n in casa_bgp.networks|default([]) %}
  network {{ n|ansible.utils.ipaddr('address') }} mask {{ n|ansible.utils.ipaddr('netmask') }}
{% endfor %}
{% for nb in casa_bgp.ext_neighbors|default([]) if nb.ipv4 is defined %}
  neighbor {{ nb.ipv4 }} activate
{%   if nb.advertisement_interval is defined %}
  neighbor {{ nb.ipv4 }} advertisement-interval {{ nb.advertisement_interval }}
{%   endif %}
{%   if nb.soft_reconfiguration_inbound|default(False) %}
  neighbor {{ nb.ipv4 }} soft-reconfiguration inbound
{%   endif %}
{%   if nb.prefix_list_in is defined %}
  neighbor {{ nb.ipv4 }} prefix-list {{ nb.prefix_list_in }} in
{%   endif %}
{%   if nb.prefix_list_out is defined %}
  neighbor {{ nb.ipv4 }} prefix-list {{ nb.prefix_list_out }} out
{%   endif %}
{% endfor %}
  exit-address-family
{% endif %}
!
