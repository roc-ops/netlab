{#
  Casa CMTS RIP (RocContLab #64). Casa NSI Ch.29:
    router rip -> version 2 ; network <ip>/<prefix> (per-interface subnet) ; passive-interface
  IPv4 RIPv2 ONLY. Casa attaches interfaces to RIP via `network` statements (there is NO
  interface `ip rip enable`). RIPng (`router ipv6 rip`) has NO documented interface-attach
  command in the NSI reference, so IPv6 RIP is intentionally NOT rendered (honest gap — see
  the `ripv2` feature in casa.yml; revisit if the Subscriber-Access ref documents the attach).
  netlab model: node `ripv2.af`; per-if `l.ripv2` (present on RIP interfaces), `l.ripv2.passive`.
#}
{% if 'ipv4' in ripv2.af %}
router rip
  version 2
{%   for l in netlab_interfaces|default([]) if 'ripv2' in l and 'ipv4' in l and l.ipv4 is string %}
  network {{ l.ipv4|ansible.utils.ipaddr('subnet') }}
{%   endfor %}
{%   for l in netlab_interfaces|default([]) if 'ripv2' in l and l.ripv2.passive|default(False) %}
  passive-interface {{ l.ifname }}
{%   endfor %}
!
{% endif %}
