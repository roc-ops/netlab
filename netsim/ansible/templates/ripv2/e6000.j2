{#
  Arris E6000 CER RIP (RocContLab, E6000 CLI Ch.2).
    router rip vrf default -> network <A.B.C.D> (CLASSFUL network address, no mask) /
                              passive-interface <type> <id>
  E6000 RIP joins interfaces via router-mode `network` statements (like OSPF), IPv4 only — RIPng is not
  modeled. NOTE: the reference config does not run RIP, so this is CLI-ref-grounded (E6000 CLI Ch.2),
  NOT reference-config-verified. netlab model: per-if l.ripv2.{passive}; interface IPv4 addresses.
#}
{% set ns = namespace(any=false) %}
{% for l in netlab_interfaces|default([]) if 'ripv2' in l and 'ipv4' in l and l.ipv4 is string %}
{% set ns.any = true %}
{% endfor %}
{% if ns.any %}
router rip vrf default
{% for l in netlab_interfaces|default([]) if 'ripv2' in l and 'ipv4' in l and l.ipv4 is string %}
 network {{ l.ipv4|ansible.utils.ipaddr('network') }}
{% endfor %}
{% for l in netlab_interfaces|default([]) if 'ripv2' in l and l.ripv2.passive|default(False) %}
 passive-interface {{ l.ifname }}
{% endfor %}
exit
{% endif %}
