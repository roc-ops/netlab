{#
  Casa CMTS initial config (RocContLab #48/#53). hostname + per-interface addressing + device-scoped
  NSI interface attributes (encapsulation/parent/secondaries/mac/pim + tail: mtu/mpls-mtu/rsvp/tpid/
  access-group/rate-limit/ipv6-dad/cable-helper — declared in devices/casa.yml). External device;
  netlab renders the artifact, never deploys. IPv4 = dotted netmask, IPv6 = CIDR. netlab_interfaces =
  [loopback] + interfaces (loopback first); mgmt is NOT in the list (lives in `mgmt`).
#}
{# netlab_manage_identity is False by default for external-provider nodes (see
   netsim/providers/external.py): a CMTS already in service has a hostname, and
   renaming it out from under the operator is not netlab's call. #}
{% if netlab_manage_identity|default(True) %}
hostname {{ inventory_hostname.replace("_","-") }}
!
{% endif %}
{# The SYSTEM loopback on a pre-existing CMTS is load-bearing (it anchors the OSPF
   router-id and is the source-interface for logging/ipdr), and netlab's idea of it
   is not the box's -- this Casa uses loopback 1, not loopback 0. Skip it unless
   netlab is the owner of record. Additional loopbacks are netlab's own. #}
{% for l in netlab_interfaces
     if netlab_manage_identity|default(True) or l.ifname != loopback.ifname|default('') %}
interface {{ l.ifname }}
{% for m in l.lag_members|default([]) %}
  {{ m.port }} mode {{ m.mode }}
{% endfor %}
{# On a pre-existing device the interface description belongs to the OPERATOR, and on the Casa
   it is load-bearing: description "NETLAB: ..." is what delegates a port to netlab. Rendering
   our own description over it un-delegates the port on the very push it was delegated for, so
   the service would work exactly once. netlab_manage_identity already records who owns this
   device's identity, and a description is part of that. #}
{% if l.name is defined and netlab_manage_identity|default(True) %}
  description "{{ l.name }}{{ " ["+l.role+"]" if l.role is defined else "" }}"
{% endif %}
{% if l.encapsulation is defined %}
  encapsulation {{ l.encapsulation }}
{% endif %}
{% if l.parent is defined %}
  {{ l.parent }}
{% endif %}
{% if l.mtu is defined %}
  mtu {{ l.mtu }}
{% endif %}
{% if "ipv4" in l and l.ipv4 is string %}
  ip address {{ l.ipv4|ansible.utils.ipaddr("address") }} {{ l.ipv4|ansible.utils.ipaddr("netmask") }}
{% endif %}
{% for s in l.secondary_ipv4|default([]) %}
  ip address {{ s|ansible.utils.ipaddr("address") }} {{ s|ansible.utils.ipaddr("netmask") }} secondary
{% endfor %}
{% if "ipv6" in l and l.ipv6 is string %}
  ipv6 address {{ l.ipv6 }}
{% endif %}
{% for h in l.cable_helper_address|default([]) %}
  cable helper-address {{ h.ip }}{{ " "+h.scope if h.scope is defined else "" }}
{% endfor %}
{% if l.ip_access_group is defined %}
  ip access-group {{ l.ip_access_group }}
{% endif %}
{% if l.mpls_mtu is defined %}
  mpls mtu {{ l.mpls_mtu }}
{% endif %}
{% if l.rsvp is defined %}
{%   if l.rsvp.hello_interval is defined %}
  rsvp hello-interval {{ l.rsvp.hello_interval }}
{%   endif %}
{%   if l.rsvp.hello_timeout is defined %}
  rsvp hello-timeout {{ l.rsvp.hello_timeout }}
{%   endif %}
{%   if l.rsvp.keep_multiplier is defined %}
  rsvp keep-multiplier {{ l.rsvp.keep_multiplier }}
{%   endif %}
{%   if l.rsvp.refresh_time is defined %}
  rsvp refresh-time {{ l.rsvp.refresh_time }}
{%   endif %}
{% endif %}
{% if l.mac_address is defined %}
  mac address {{ l.mac_address }}
{% endif %}
{% if l.pim|default(False) %}
  ip pim sparse-mode
{% endif %}
{% if l.igmp|default(False) %}
  ip igmp
{% endif %}
{% if l.rate_limit_multicast is defined %}
  rate-limit multicast {{ l.rate_limit_multicast }}
{% endif %}
{% if l.l2vpn is defined %}
{%   if l.l2vpn.dhcp_insert_option is defined %}
  no l2vpn dhcp-insert option {{ l.l2vpn.dhcp_insert_option }}
{%   endif %}
{%   if l.l2vpn.mac_address_interval is defined %}
  l2vpn mac-address interval {{ l.l2vpn.mac_address_interval }}
{%   endif %}
{% endif %}
{% if l.tpid is defined %}
  tpid {{ l.tpid }}
{% endif %}
{% if l.ipv6_dad|default(False) %}
  ipv6 dad enable
{% endif %}
{% if l.fec|default(False) %}
  fec
{% endif %}
{% if l.type != 'loopback' %}
  no shutdown
{% endif %}
!
{% endfor %}
{# ---- OSPF (device-scoped casa_ospf: process-level network statements + passive model). Rendered
       here in the always-active initial template because netlab drops the interface-driven ospf
       module when no interface uses OSPF (Casa joins via network statements, not per-interface). ---- #}
{% if casa_ospf is defined %}
router ospf {{ casa_ospf.process }}
{%   if casa_ospf.router_id is defined %}
  router-id {{ casa_ospf.router_id }}
{%   endif %}
{%   if casa_ospf.passive_default|default(False) %}
  passive-interface default
{%     for i in casa_ospf.passive_active|default([]) %}
  no passive-interface {{ i }}
{%     endfor %}
{%   endif %}
{%   for n in casa_ospf.networks|default([]) %}
  network {{ n.prefix }} area {{ n.area }}
{%   endfor %}
!
{% endif %}
