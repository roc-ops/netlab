{#
  Casa CMTS initial config (RocContLab #48/#53). IOS-like: hostname + per-interface addressing +
  device-scoped NSI interface attributes (encapsulation / parent / secondary IPs / mac / pim —
  declared in devices/casa.yml). External device — renders the config artifact; netlab does not
  deploy it. Casa CLI: `interface gige <slot>/<port>` / `interface loopback <n>`; IPv4 = dotted
  netmask, IPv6 = CIDR. netlab_interfaces = [loopback] + interfaces (loopback first); the mgmt
  interface is NOT in this list (it lives in `mgmt`) so management reachability is never touched.
#}
hostname {{ inventory_hostname.replace("_","-") }}
!
{% for l in netlab_interfaces %}
interface {{ l.ifname }}
{% if l.name is defined %}
  description "{{ l.name }}{{ " ["+l.role+"]" if l.role is defined else "" }}"
{% endif %}
{% if l.encapsulation is defined %}
  encapsulation {{ l.encapsulation }}
{% endif %}
{% if l.parent is defined %}
  {{ l.parent }}
{% endif %}
{% if "ipv4" in l and l.ipv4 is string %}
  ip address {{ l.ipv4|ansible.utils.ipaddr("address") }} {{ l.ipv4|ansible.utils.ipaddr("netmask") }}
{% endif %}
{% for s in l.secondary_ipv4|default([]) %}
  ip address {{ s|ansible.utils.ipaddr("address") }} {{ s|ansible.utils.ipaddr("netmask") }} secondary
{% endfor %}
{% if "ipv6" in l and l.ipv6 is string %}
  ipv6 address {{ l.ipv6 }}
{% endif %}
{% if l.mac_address is defined %}
  mac address {{ l.mac_address }}
{% endif %}
{% if l.pim|default(False) %}
  ip pim sparse-mode
{% endif %}
{% if l.type != 'loopback' %}
  no shutdown
{% endif %}
!
{% endfor %}
